+def _memory_path() -> Path:
+    return Path(os.environ["HERMES_HOME"]).resolve() / "memories" / "MEMORY.md"
+
+
+def _read_memory_entries() -> List[str]:
+    path = _memory_path()
+    if not path.exists():
+        return []
+    return [entry.strip() for entry in path.read_text(encoding="utf-8", errors="replace").split(MEMORY_DELIMITER) if entry.strip()]
+
+
+def _write_memory_entries(entries: List[str]) -> None:
+    path = _memory_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    unique_entries: List[str] = []
+    seen = set()
+    for entry in entries:
+        normalized = " ".join(str(entry).split())
+        if not normalized or normalized in seen:
+            continue
+        seen.add(normalized)
+        unique_entries.append(normalized)
+
+    while unique_entries and len(MEMORY_DELIMITER.join(unique_entries)) > MEMORY_LIMIT:
+        unique_entries.pop(0)
+
+    path.write_text(MEMORY_DELIMITER.join(unique_entries), encoding="utf-8")
+
+
+def _summarize_incident_records(workspace_dir: Path) -> Dict[str, Any]:
+    records: List[Dict[str, Any]] = []
+    incidents_dir = workspace_dir / "data" / "incidents"
+    for path in sorted(incidents_dir.glob("*.json")):
+        try:
+            payload = json.loads(path.read_text(encoding="utf-8"))
+        except Exception:
+            continue
+        if isinstance(payload, dict):
+            records.append(payload)
+
+    owner_counts: Dict[str, int] = {}
+    issue_counts: Dict[str, int] = {}
+    total_severity = 0
+    for record in records:
+        owner = str(record.get("owner") or "")
+        issue_id = str(record.get("issueId") or "")
+        total_severity += int(record.get("severity") or 0)
+        owner_counts[owner] = owner_counts.get(owner, 0) + 1
+        issue_counts[issue_id] = issue_counts.get(issue_id, 0) + 1
+
+    return {
+        "totalIncidents": len(records),
+        "totalSeverity": total_severity,
+        "topOffenders": [
+            {"owner": owner, "count": count}
+            for owner, count in sorted(owner_counts.items(), key=lambda item: (-item[1], item[0]))[:3]
+        ],
+        "duplicateIssueIds": sorted(issue_id for issue_id, count in issue_counts.items() if count > 1),
+    }
+
+
+def _write_workspace_json(workspace_dir: Path, relative_path: str, payload: Dict[str, Any]) -> Path:
+    path = _safe_workspace_path(workspace_dir, relative_path)
+    if not path:
+        raise ValueError(f"unsafe workspace path: {relative_path}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    return path
+
+
+def _skill_root() -> Path:
+    return Path(os.environ["HERMES_HOME"]).resolve() / "skills"
+
+
+def _safe_skill_path(*parts: str) -> Optional[Path]:
+    root = _skill_root()
+    candidate = root.joinpath(*parts).resolve()
+    try:
+        candidate.relative_to(root.resolve())
+    except ValueError:
+        return None
+    return candidate
+
+
+def _write_skill_file(parts: List[str], content: str) -> Optional[Path]:
+    path = _safe_skill_path(*parts)
+    if not path:
+        return None
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content, encoding="utf-8")
+    return path
+
+
+def _incident_text_summary(workspace_dir: Path) -> str:
+    summary = _summarize_incident_records(workspace_dir)
+    top = summary["topOffenders"][0] if summary["topOffenders"] else {"owner": "NONE", "count": 0}
+    duplicates = ",".join(summary["duplicateIssueIds"]) if summary["duplicateIssueIds"] else "NONE"
+    return "\n".join([
+        f"TOTAL={summary['totalIncidents']}",
+        f"TOP={top['owner']}:{top['count']}",
+        f"DUPLICATES={duplicates}",
+    ])
+
+
+def _patch_compose_backend_network(workspace_dir: Path) -> Optional[Dict[str, str]]:
+    relative_path = "docker-compose.yml"
+    path = _safe_workspace_path(workspace_dir, relative_path)
+    if not path or not path.exists():
+        return None
+    before = path.read_text(encoding="utf-8", errors="replace")
+    old = "    depends_on:\n      - db\n"
+    new = "    depends_on:\n      - db\n    networks:\n      - backend\n"
+    if new in before:
+        return {"path": relative_path, "before": before, "after": before, "old": "", "new": ""}
+    if old not in before:
+        return None
+    after = before.replace(old, new, 1)
+    path.write_text(after, encoding="utf-8")
+    return {"path": relative_path, "before": before, "after": after, "old": old, "new": new}
+
+
+def _delegation_summary(workspace_dir: Path) -> Dict[str, Any]:
+    def _read_lines(relative_path: str) -> List[str]:
+        path = _safe_workspace_path(workspace_dir, relative_path)
+        if not path or not path.exists():
+            return []
+        return [line.strip() for line in path.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()]
+
+    integers = [int(item) for item in _read_lines("inputs/a.txt")]
+    names = sorted(_read_lines("inputs/b.txt"))
+    counts: Dict[int, int] = {}
+    for item in _read_lines("inputs/c.txt"):
+        value = int(item)
+        counts[value] = counts.get(value, 0) + 1
+    return {
+        "sum": sum(integers),
+        "sortedNames": names,
+        "duplicateCounts": {str(value): count for value, count in sorted(counts.items()) if count > 1},
+    }
+
